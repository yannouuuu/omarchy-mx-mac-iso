#!/bin/busybox sh
# Live boot late hook, using the enumeration pattern proven on Apple Silicon
# hardware: settle + udevadm trigger, payload by label/partlabel, separate
# overlay mounts, vendor firmware carried across switch_root. On failure, a
# diagnostic report is persisted to the internal System ESP.

retrigger_udev() {
    if command -v udevadm >/dev/null 2>&1; then
        udevadm settle --timeout=10 2>/dev/null
        udevadm trigger --action=add 2>/dev/null
        udevadm settle --timeout=10 2>/dev/null
    fi
}

force_host_roles() {
    # Last-resort nudges: ask every Type-C port and dwc3 controller to take
    # the host role, in case automatic role switching stalled.
    for role in /sys/bus/platform/devices/*.usb/*/role /sys/bus/platform/devices/*.usb/role; do
        [ -w "$role" ] && echo host >"$role" 2>/dev/null
    done
    for data_role in /sys/class/typec/port*/data_role; do
        [ -e "$data_role" ] || continue
        grep -q '\[device\]' "$data_role" 2>/dev/null && echo host >"$data_role" 2>/dev/null
    done
}

mount_system_esp() {
    sys_esp_guid=$(tr -d '\0' < /proc/device-tree/chosen/asahi,efi-system-partition 2>/dev/null)
    [ -n "$sys_esp_guid" ] || sys_esp_guid=$(tr -d '\0' < /proc/device-tree/asahi,efi-system-partition 2>/dev/null)
    [ -n "$sys_esp_guid" ] && [ -e "/dev/disk/by-partuuid/$sys_esp_guid" ] || return 1
    mkdir -p "$1"
    mount -t vfat -o rw "/dev/disk/by-partuuid/$sys_esp_guid" "$1" 2>/dev/null
}

payload_device() {
    if [ -e /dev/disk/by-partlabel/omarchy-mx-root ]; then
        readlink -f /dev/disk/by-partlabel/omarchy-mx-root
    elif [ -b /dev/sda2 ]; then
        echo /dev/sda2
    fi
}

write_report() {
    report=/tmp/omarchy-mx-mac-iso-report.txt
    stamp=$(date +%Y%m%d-%H%M)
    {
        echo "=== omarchy-mx-mac-iso diagnostic report ==="
        date
        echo; echo "--- /proc/cmdline"; cat /proc/cmdline
        echo; echo "--- /proc/modules"; cat /proc/modules
        echo; echo "--- /proc/filesystems"; cat /proc/filesystems
        echo; echo "--- typec state"
        for port in /sys/class/typec/port*; do
            [ -e "$port" ] || continue
            echo "$port:"
            for f in data_role power_role preferred_role vconn_source; do
                [ -e "$port/$f" ] && echo "  $f = $(cat "$port/$f" 2>/dev/null)"
            done
        done
        echo; echo "--- udc (peripheral controllers)"; ls -l /sys/class/udc/ 2>/dev/null
        echo; echo "--- dwc3 role files"
        for role in /sys/bus/platform/devices/*.usb/*/role /sys/bus/platform/devices/*.usb/role; do
            [ -e "$role" ] && echo "$role = $(cat "$role" 2>/dev/null)"
        done
        echo; echo "--- /dev storage nodes"; ls -l /dev/sd* /dev/nvme* 2>/dev/null
        echo; echo "--- dmesg (usb/phy/mux/typec/pd)"
        dmesg | grep -iE 'usb|xhci|dwc3|phy|mux|typec|pd|storage|sd[a-z]' | tail -n 80
        echo; echo "--- dmesg (full tail)"
        dmesg | tail -n 120
    } >"$report" 2>&1

    # Preferred: the stick's own ESP. When the stick itself is what failed,
    # it is as invisible as the payload, so fall through to the internal one.
    if [ -e /dev/disk/by-partlabel/omarchy-mx-esp ]; then
        mkdir -p /run/esp
        if mount -t vfat -o rw /dev/disk/by-partlabel/omarchy-mx-esp /run/esp 2>/dev/null; then
            cp "$report" "/run/esp/omarchy-mx-mac-iso-report-$stamp.txt"
            umount /run/esp
            echo "omarchy-live: report saved on the stick ESP" >&2
            return 0
        fi
    fi

    # The internal System ESP is always visible (NVMe works even when USB
    # does not). The asahi hook mounts and unmounts it early, so mount it
    # ourselves via the PARTUUID published in the device tree.
    if mount_system_esp /run/esp-rw; then
        mkdir -p /run/esp-rw/omarchy-mx-mac-iso-reports 2>/dev/null
        if cp "$report" "/run/esp-rw/omarchy-mx-mac-iso-reports/report-$stamp.txt" 2>/dev/null; then
            umount /run/esp-rw
            echo "omarchy-live: report saved to the internal ESP (omarchy-mx-mac-iso-reports/report-$stamp.txt)" >&2
            return 0
        fi
        umount /run/esp-rw 2>/dev/null
    fi

    echo "omarchy-live: report could not be persisted; it is at $report in this shell" >&2
    return 1
}

run_latehook() {
    live_mount=/run/omarchy-root
    ovl_mount=/run/omarchy-ovl
    new_root=/new_root

    # Filesystem modules have no device modalias, so udev never loads them.
    modprobe btrfs 2>/dev/null
    modprobe overlay 2>/dev/null

    # Enumeration pattern proven on hardware: settle, re-trigger every add
    # event, settle again. A port whose Type-C role was negotiated before
    # the kernel took over only starts host mode after this.
    retrigger_udev
    sleep 2

    tries=0
    while [ -z "$(payload_device)" ] && [ "$tries" -lt 6 ]; do
        if [ "$tries" -gt 0 ] && [ $((tries % 2)) -eq 1 ]; then
            echo "omarchy-live: payload not found yet, re-triggering udev" >&2
            retrigger_udev
        fi
        sleep 5
        tries=$((tries + 1))
    done

    # Still nothing: force host roles everywhere and give it one more window.
    if [ -z "$(payload_device)" ]; then
        echo "omarchy-live: forcing host roles on every Type-C port" >&2
        force_host_roles
        retrigger_udev
        sleep 6
    fi

    dev=$(payload_device)
    if [ -z "$dev" ]; then
        echo "omarchy-live: payload partition omarchy-mx-root not found" >&2
        write_report
        echo "omarchy-live: reboot to macOS; the report is on the internal ESP" >&2
        exec sh
    fi

    mkdir -p "$live_mount"
    if ! mount -t btrfs -o ro,subvol=@ "$dev" "$live_mount"; then
        echo "omarchy-live: mounting $dev subvol=@ failed" >&2
        write_report
        exec sh
    fi

    # Payload and overlay live on separate mounts: the overlay lowerdir must
    # not be the same mountpoint the overlay lands on.
    mkdir -p "$ovl_mount" "$new_root"
    mount -t tmpfs tmpfs "$ovl_mount"
    mkdir -p "$ovl_mount/upper" "$ovl_mount/work"
    if ! mount -t overlay overlay \
        -o "lowerdir=$live_mount,upperdir=$ovl_mount/upper,workdir=$ovl_mount/work" \
        "$new_root"; then
        echo "omarchy-live: overlay mount failed" >&2
        write_report
        exec sh
    fi

    # Carry the vendor firmware across switch_root: the asahi hook copied it
    # to /new_root before the overlay covered that path.
    if [ -d /lib/firmware/vendor ]; then
        mkdir -p "$new_root/lib/firmware/vendor"
        cp -a /lib/firmware/vendor/. "$new_root/lib/firmware/vendor/"
    fi
    if [ -d /vendorfw ]; then
        mkdir -p "$new_root/vendorfw"
        cp -a /vendorfw/. "$new_root/vendorfw/"
    fi

    mkdir -p "$new_root/proc" "$new_root/sys" "$new_root/dev" "$new_root/run"
    mount --move /proc "$new_root/proc" 2>/dev/null || mount -t proc proc "$new_root/proc"
    mount --move /sys "$new_root/sys" 2>/dev/null || mount -t sysfs sysfs "$new_root/sys"
    mount --move /dev "$new_root/dev" 2>/dev/null || mount --bind /dev "$new_root/dev"
    mount --move /run "$new_root/run" 2>/dev/null || true

    # Progress marker: if this lands on the internal ESP but the boot still
    # fails, USB was fine and the failure happened after the payload stage.
    stamp=$(date +%Y%m%d-%H%M)
    if mount_system_esp /run/esp-marker; then
        mkdir -p /run/esp-marker/omarchy-mx-mac-iso-reports 2>/dev/null
        echo "payload mounted, overlay ready, about to switch_root" \
            >"/run/esp-marker/omarchy-mx-mac-iso-reports/reached-switch_root-$stamp.txt"
        umount /run/esp-marker
    fi

    echo "omarchy-live: switching root" >&2
    # shellcheck disable=SC2093  # the lines below only run if exec failed
    exec switch_root "$new_root" /sbin/init

    echo "omarchy-live: switch_root returned" >&2
    write_report
    exec sh
}

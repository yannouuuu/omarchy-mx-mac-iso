#!/bin/busybox sh
# Live boot late hook: find the payload, overlay it writable, switch_root.
# When the payload never shows up, write a full diagnostic report to the
# stick's own ESP (readable from macOS) before dropping to a shell.

retrigger_usb() {
    # A port that negotiated its Type-C role before the kernel took over may
    # never start host mode (seen on t8112: the controller holding the stick
    # stayed silent while the other one worked). Kicking every dwc3
    # controller forces each port to renegotiate, so it does not matter
    # which USB-C port the stick is plugged into.
    for dev in /sys/bus/platform/drivers/dwc3-apple/*:*; do
        [ -e "$dev" ] || continue
        echo "${dev##*/}" > /sys/bus/platform/drivers/dwc3-apple/unbind 2>/dev/null
    done
    sleep 1
    for dev in /sys/bus/platform/devices/*usb; do
        [ -e "$dev" ] || continue
        echo "${dev##*/}" > /sys/bus/platform/drivers/dwc3-apple/bind 2>/dev/null
    done
}

force_host_roles() {
    # Last-resort nudges: ask every Type-C port and every dwc3 controller to
    # take the host role, in case automatic role switching stalled.
    for role in /sys/bus/platform/devices/*.usb/*/role /sys/bus/platform/devices/*.usb/role; do
        [ -w "$role" ] && echo host >"$role" 2>/dev/null
    done
    for data_role in /sys/class/typec/port*/data_role; do
        [ -e "$data_role" ] || continue
        grep -q '\[device\]' "$data_role" 2>/dev/null && echo host >"$data_role" 2>/dev/null
    done
}

write_report() {
    report=/tmp/omarchy-live-report.txt
    stamp=$(date +%Y%m%d-%H%M)
    {
        echo "=== omarchy-live diagnostic report ==="
        date
        echo; echo "--- /proc/cmdline"; cat /proc/cmdline
        echo; echo "--- /proc/modules"; cat /proc/modules
        echo; echo "--- /proc/filesystems"; cat /proc/filesystems
        echo; echo "--- typec state"
        for port in /sys/class/typec/port*; do
            [ -e "$port" ] || continue
            echo "$port:"
            for f in data_role power_role preferred_role vconn_source; do
                [ -e "$port/$f" ] && echo "  $f = $(cat "$port/$f" 2>/dev/null)"
            done
        done
        echo; echo "--- udc (peripheral controllers)"; ls -l /sys/class/udc/ 2>/dev/null
        echo; echo "--- dwc3 role files"
        for role in /sys/bus/platform/devices/*.usb/*/role /sys/bus/platform/devices/*.usb/role; do
            [ -e "$role" ] && echo "$role = $(cat "$role" 2>/dev/null)"
        done
        echo; echo "--- /dev storage nodes"; ls -l /dev/sd* /dev/nvme* 2>/dev/null
        echo; echo "--- dmesg (usb/phy/mux/typec/pd)"
        dmesg | grep -iE 'usb|xhci|dwc3|phy|mux|typec|pd|storage|sd[a-z]' | tail -n 80
        echo; echo "--- dmesg (full tail)"
        dmesg | tail -n 120
    } >"$report" 2>&1

    # Preferred target: the stick's own ESP — but when the stick is the thing
    # that failed, it is as invisible as the payload, so fall through.
    if [ -e /dev/disk/by-partlabel/omarchy-mx-esp ]; then
        mkdir -p /run/esp
        if mount -t vfat -o rw /dev/disk/by-partlabel/omarchy-mx-esp /run/esp 2>/dev/null; then
            cp "$report" "/run/esp/omarchy-mx-mac-iso-report-$stamp.txt"
            umount /run/esp
            echo "omarchy-live: report saved on the stick ESP (omarchy-mx-mac-iso-report-$stamp.txt)" >&2
            return 0
        fi
    fi

    # The internal System ESP is always visible (NVMe works even when USB
    # does not). The asahi hook mounts and unmounts it early, so mount it
    # ourselves: its PARTUUID is published in the device tree.
    sys_esp_guid=$(tr -d '\0' < /proc/device-tree/chosen/asahi,efi-system-partition 2>/dev/null)
    [ -n "$sys_esp_guid" ] || sys_esp_guid=$(tr -d '\0' < /proc/device-tree/asahi,efi-system-partition 2>/dev/null)
    if [ -n "$sys_esp_guid" ] && [ -e "/dev/disk/by-partuuid/$sys_esp_guid" ]; then
        mkdir -p /run/esp-rw
        if mount -t vfat -o rw "/dev/disk/by-partuuid/$sys_esp_guid" /run/esp-rw 2>/dev/null; then
            mkdir -p /run/esp-rw/omarchy-mx-mac-iso-reports 2>/dev/null
            if cp "$report" "/run/esp-rw/omarchy-mx-mac-iso-reports/report-$stamp.txt" 2>/dev/null; then
                umount /run/esp-rw
                echo "omarchy-live: report saved to the internal ESP (omarchy-mx-mac-iso-reports/report-$stamp.txt)" >&2
                return 0
            fi
            umount /run/esp-rw 2>/dev/null
        fi
    fi

    echo "omarchy-live: report could not be persisted; it is at $report in this shell" >&2
    return 1
}

run_latehook() {
    payload=/dev/disk/by-partlabel/omarchy-mx-root

    # Filesystem modules have no device modalias, so udev never loads them:
    # request btrfs explicitly (xor and raid6_pq come along as dependencies).
    modprobe btrfs 2>/dev/null

    # Wait for the stick, kicking the controllers while it stays invisible:
    # hot-plug handles a slow port, rebind handles a port stuck before it
    # ever started host mode.
    tries=0
    while [ ! -e "$payload" ] && [ "$tries" -lt 6 ]; do
        if [ "$tries" -gt 0 ] && [ $((tries % 2)) -eq 1 ]; then
            echo "omarchy-live: payload not found yet, kicking USB controllers"
            retrigger_usb
        fi
        sleep 5
        tries=$((tries + 1))
    done

    # Still nothing: force host roles everywhere and give it one more window.
    if [ ! -e "$payload" ]; then
        echo "omarchy-live: forcing host roles on every Type-C port"
        force_host_roles
        sleep 6
    fi

    if [ ! -e "$payload" ]; then
        echo "omarchy-live: payload partition omarchy-mx-root not found" >&2
        write_report
        echo "omarchy-live: reboot to macOS and open omarchy-live-report.txt from the stick" >&2
        exec sh
    fi

    mkdir -p /new_root
    if ! mount -o ro,subvol=@ "$payload" /new_root; then
        echo "omarchy-live: mounting the payload failed" >&2
        cat /proc/filesystems >&2
        write_report
        exec sh
    fi

    # A tmpfs overlay makes the read-only payload behave like a writable
    # system without ever writing to the stick itself.
    mkdir -p /new_root/run/omarchy-live-upper /new_root/run/omarchy-live-work
    if ! mount -t overlay overlay \
        -o lowerdir=/new_root,upperdir=/new_root/run/omarchy-live-upper,workdir=/new_root/run/omarchy-live-work \
        /new_root; then
        echo "omarchy-live: overlay setup failed; continuing read-only" >&2
    fi

    echo "omarchy-live: switching root"
}

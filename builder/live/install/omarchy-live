#!/bin/mkinitcpio-dynamic-presets
# mkinitcpio install hook: pulls the live-boot modules into the image.

build() {
  add_module "apple_tunable"
  add_module "phy_apple_atc"
  add_module "mux_apple_display_crossbar"
  add_module "typec"
  add_module "tps6598x_core"
  add_module "tps6598x"
  add_module "dwc3"
  add_module "dwc3_apple"
  add_module "xhci_plat_hcd"
  add_module "xhci_hcd"
  add_module "usb_storage"
  add_module "uas"
  add_module "loop"
  add_module "overlay"
  add_module "btrfs"
  add_module "nls_iso8859_1"
  add_binary "switch_root"
  add_binary "losetup"
  add_binary "udevadm"
  add_runscript
}

help() {
  cat <<HELPEOF
omarchy-live: waits for the btrfs payload partition (PARTLABEL
omarchy-mx-root), re-triggering udev so every Type-C controller gets a
second chance to enumerate, mounts it read-only on subvol @, overlays a
tmpfs, carries the vendor firmware across switch_root, and boots the live
system. On failure a diagnostic report is persisted to the internal System
ESP (omarchy-mx-mac-iso-reports/).
HELPEOF
}

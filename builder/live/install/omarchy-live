#!/bin/mkinitcpio-dynamic-presets
# mkinitcpio install hook: pulls the live-boot modules into the image.

build() {
  add_module "apple_tunable"
  add_module "phy_apple_atc"
  add_module "mux_apple_display_crossbar"
  add_module "typec"
  add_module "tps6598x_core"
  add_module "tps6598x"
  add_module "dwc3"
  add_module "dwc3_apple"
  add_module "xhci_plat_hcd"
  add_module "xhci_hcd"
  add_module "usb_storage"
  add_module "uas"
  add_module "loop"
  add_module "overlay"
  add_module "btrfs"
  add_module "nls_iso8859_1"
  add_binary "switch_root"
  add_binary "losetup"
  add_binary "udevadm"
  # The mkinitcpio busybox omits these applets; the hook needs them for the
  # report (date), the System ESP lookup (tr), and its filters.
  add_binary "date"
  add_binary "tr"
  add_binary "grep"
  add_binary "awk"
  add_binary "cut"
  add_binary "head"
  add_binary "sort"
  add_binary "dmesg"
  add_binary "readlink"
  add_runscript
}

help() {
  cat <<HELPEOF
omarchy-live: premount hook — waits for the btrfs payload partition
(PARTLABEL omarchy-mx-root), re-triggering udev so every Type-C controller
gets a second chance to enumerate, mounts it read-only on subvol @, overlays
a tmpfs, carries the vendor firmware across switch_root, and boots the live
system. Runs in the premount phase: the stock init would fail mounting the
empty root= before late hooks ever run. On failure a diagnostic report is
persisted to the internal System ESP (omarchy-mx-mac-iso-reports/).
HELPEOF
}
